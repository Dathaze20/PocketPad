<!--
  Concentric rings radiating from a point: the phone making itself visible.

  Drawn white and tinted at the point of use, so one drawable serves both the dark
  glyph on a coloured tile and the light glyph on a grey one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,9.6a2.4,2.4 0 1,0 0.01,0z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:strokeLineCap="butt"
        android:pathData="M12,6.2a5.8,5.8 0 1,0 0.01,0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:strokeLineCap="butt"
        android:pathData="M12,2.6a9.4,9.4 0 1,0 0.01,0" />
</vector>
