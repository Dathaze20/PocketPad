<?xml version="1.0" encoding="utf-8"?>
<!-- Immediate feedback on touch; transparent at rest so the sheet stays calm. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <solid android:color="@color/pp_row_pressed" />
        <corners android:radius="12dp" />
    </shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape></item>
</selector>
