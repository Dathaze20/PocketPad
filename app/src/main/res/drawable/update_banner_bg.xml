<?xml version="1.0" encoding="utf-8"?>
<!--
  Matches My Music's .battery-banner: #1e293b fill, #334155 hairline, 14dp corners.
  The shadow is applied as elevation on the view, since a shape cannot carry one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/pp_banner_bg" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/pp_banner_border" />
</shape>
