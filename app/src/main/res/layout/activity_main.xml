<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pp_background">

    <com.dathaze.pocketpad.ui.ControllerView
        android:id="@+id/controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/editBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:background="@drawable/status_pill"
        android:padding="6dp"
        android:visibility="gone">

        <!--
          Resizing. Always present in edit mode so the feature is discoverable, but inert until
          a control is tapped — the prompt says what to do, and the slider is disabled so it
          cannot be dragged with nothing to apply it to.
        -->
        <LinearLayout
            android:id="@+id/sizeRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/sizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="150dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/pp_text_dim"
                android:textSize="12sp"
                android:text="@string/edit_size_prompt" />

            <SeekBar
                android:id="@+id/sizeSlider"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:contentDescription="@string/edit_size_prompt" />

            <Button
                android:id="@+id/sizeReset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:textSize="12sp"
                android:textColor="@color/pp_text"
                android:text="@string/edit_size_reset" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

        <Button
            android:id="@+id/editSave"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pp_accent"
            android:text="@string/edit_save" />

        <Button
            android:id="@+id/editReset"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pp_text"
            android:text="@string/edit_reset" />

        <Button
            android:id="@+id/editCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pp_text_dim"
            android:text="@string/edit_cancel" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="6dp"
        android:background="@drawable/status_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/pp_text_dim"
        android:textSize="12sp"
        android:text="@string/status_idle" />

</FrameLayout>
