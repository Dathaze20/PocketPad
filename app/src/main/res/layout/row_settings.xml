<?xml version="1.0" encoding="utf-8"?>
<!--
  One settings row: glyph tile, label with optional subtitle, and a trailing value, badge or
  switch.

  Two things here exist to stop text breaking in the middle of a word, which is what a TextView
  does when a single word is wider than the line it is on:

  - Every text view is `maxLines="1"` with `ellipsize="end"`. One line cannot wrap, so it can
    never break mid-word; a label too long for the space loses its tail to an ellipsis instead.
  - `breakStrategy="simple"` and `hyphenationFrequency="none"`, so the layout never tries to be
    clever about where to divide a word.

  The height is a minimum rather than a fixed value. It was fixed at 56dp, which cannot survive
  a large font scale — the text grows out of the box and is clipped. 48dp is the smallest
  comfortable touch target, and the row grows past it when the text needs the room.
-->
<com.dathaze.pocketpad.ui.SettingsRowView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/row_bg"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/row_pad_h"
    android:paddingEnd="@dimen/row_pad_h"
    android:paddingTop="@dimen/row_pad_v"
    android:paddingBottom="@dimen/row_pad_v">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="@dimen/row_icon"
        android:layout_height="@dimen/row_icon"
        android:background="@drawable/icon_tile"
        android:padding="@dimen/row_icon_pad"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/row_text_gap"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pp_text"
            android:textSize="@dimen/row_label_text"
            android:maxLines="1"
            android:ellipsize="end"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/pp_text_dim"
            android:textSize="@dimen/row_subtitle_text"
            android:maxLines="1"
            android:ellipsize="end"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Current setting, shown inline so the submenu does not have to be opened to find out. -->
    <TextView
        android:id="@+id/rowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/row_value_max"
        android:textColor="@color/pp_text_dim"
        android:textSize="@dimen/row_value_text"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rowBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/row_badge_text"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <Switch
        android:id="@+id/rowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:id="@+id/rowChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="@string/sheet_chevron"
        android:textColor="@color/pp_outline"
        android:textSize="@dimen/row_chevron_text"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:importantForAccessibility="no" />
</com.dathaze.pocketpad.ui.SettingsRowView>
