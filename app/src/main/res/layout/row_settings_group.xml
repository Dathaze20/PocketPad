<?xml version="1.0" encoding="utf-8"?>
<!--
  Section heading. Four of these turn eleven equal-weight items into something scannable.

  Smaller and tighter than it was: the headings are the cheapest height in the list to give back,
  and at a large font scale that height is what decides whether the list fits on one screen.
-->
<com.dathaze.pocketpad.ui.SettingsHeadingView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/heading_pad_h"
    android:paddingEnd="@dimen/heading_pad_h"
    android:paddingTop="@dimen/heading_pad_top"
    android:paddingBottom="@dimen/heading_pad_bottom"
    android:textColor="@color/pp_text_dim"
    android:textSize="@dimen/heading_text"
    android:textStyle="bold"
    android:letterSpacing="0.1"
    android:textAllCaps="true"
    android:maxLines="1"
    android:ellipsize="end"
    android:includeFontPadding="false" />
