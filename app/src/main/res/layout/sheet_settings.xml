<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings sheet.

  The same list it has always been — icon, label, subtitle, chevron — in a SettingsListView,
  which lays it out in one column in portrait and two side by side in landscape, and shrinks the
  rows together if a large font scale would still push it past the bottom of the screen.

  The header is one line. The title gives way before the connection state does: the title has
  the layout weight, so when there is not enough room it is the one that ellipsizes, because
  "PocketPad" is the least informative thing on the row and the name of the connected TV is the
  most. Previously both were wrap_content, which meant neither would shrink and the status ran
  off the right-hand edge.

  The ScrollView is kept only as a safety net, for font scales past the point where shrinking
  the rows further would make them unreadable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:paddingBottom="8dp">

    <!-- Grab handle: says "this came up from the bottom and can go back down". -->
    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sheet_handle_top"
        android:layout_marginBottom="@dimen/sheet_handle_bottom"
        android:background="@drawable/sheet_grab" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="@dimen/sheet_header_pad_v">

        <TextView
            android:id="@+id/sheetLogo"
            android:layout_width="@dimen/sheet_header_icon"
            android:layout_height="@dimen/sheet_header_icon"
            android:background="@drawable/icon_tile"
            android:backgroundTint="@color/pp_accent"
            android:gravity="center"
            android:text="@string/sheet_logo_glyph"
            android:textColor="@color/pp_background"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:importantForAccessibility="no" />

        <!--
          The app's own name is never abbreviated: "Po..." tells nobody anything. It takes the
          width it needs, the spacer below absorbs the slack, and the status beside it is what
          shortens — in portrait to the single word "Connected", since the device name is
          already on the banner above the sheet.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/pp_text"
            android:textSize="@dimen/sheet_header_text"
            android:textStyle="bold"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!--
          Reports the live HID link, never a remembered pairing — see SettingsSheet. Capped and
          ellipsized because a TV's advertised name can be very long.
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/status_pill"
            android:paddingStart="9dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/sheetStatusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/sheetStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/sheet_status_max"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/pp_text_dim"
                android:textSize="@dimen/sheet_status_text"
                android:includeFontPadding="false"
                tools:ignore="SelectableText" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/sheetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls"
        android:fillViewport="false">

        <com.dathaze.pocketpad.ui.SettingsListView
            android:id="@+id/sheetList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/list_pad_h"
            android:paddingEnd="@dimen/list_pad_h"
            android:paddingBottom="2dp" />
    </ScrollView>
</LinearLayout>
