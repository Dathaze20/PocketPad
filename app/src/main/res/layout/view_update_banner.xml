<?xml version="1.0" encoding="utf-8"?>
<!--
  The automatic update strip, matching My Music's .battery-banner: dark navy rounded panel,
  light text with a dimmer second line, teal action button, bare dismiss cross.

  It is added to the activity's root at the BOTTOM, above the navigation bar, and is deliberately
  narrow in height so it cannot cover the face buttons or the sticks. Touches on it do not reach
  the controller underneath, and the controller keeps working while it is on screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updateBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/update_banner_bg"
    android:elevation="8dp"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pp_banner_text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/bannerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/pp_banner_sub"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <Button
        android:id="@+id/bannerAction"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:background="@drawable/update_banner_button"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/banner_update_now"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/bannerDismiss"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/banner_dismiss_description"
        android:text="@string/banner_dismiss_glyph"
        android:textColor="@color/pp_banner_dismiss"
        android:textSize="17sp" />
</LinearLayout>
