<?xml version="1.0" encoding="utf-8"?>
<!--
  Which side of the screen the layout editor's panel starts on.

  Portrait: the bottom. The default layouts keep the lowest row of buttons around 79% of the
  height, so a panel at the very bottom covers nothing, while the top is where the triggers are.
-->
<resources>
    <bool name="edit_panel_at_bottom">true</bool>

    <!--
  Portrait: the pill says only "Connected". The device name is already spelled out on the
  status banner above the sheet, and repeating it there is what truncated the app's own name.
    -->
    <bool name="sheet_status_shows_device">false</bool>
</resources>
